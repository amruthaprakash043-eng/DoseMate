\f0\fs24 \cf0 #include <stdio.h>\
#include <string.h>\
\
#define MAX 100\
\
struct Medicine\
\{\
    int id;\
    char name[50];\
    char batch[20];\
    int day, month, year;\
    int quantity;\
    int price;\
    int reorder;\
\};\
\
struct Medicine m[MAX];\
\
int count = 0;\
\
// Convert date into number of days\
int dateToDays(int d, int mo, int y)\
\{\
    return y * 365 + mo * 30 + d;\
\}\
\
// Add Medicine Stock\
void addMedicine()\
\{\
    if (count >= MAX)\
    \{\
        printf("\\nInventory is full!\\n");\
        return;\
    \}\
\
    printf("\\nEnter Medicine ID: ");\
    scanf("%d", &m[count].id);\
\
    printf("Enter Medicine Name: ");\
    scanf(" %49[^\\n]", m[count].name);\
\
    printf("Enter Batch Number: ");\
    scanf("%19s", m[count].batch);\
\
    printf("Enter Expiry Date (DD MM YYYY): ");\
    scanf("%d %d %d", &m[count].day,\
          &m[count].month, &m[count].year);\
\
    printf("Enter Quantity: ");\
    scanf("%d", &m[count].quantity);\
\
    printf("Enter Price per unit: ");\
    scanf("%d", &m[count].price);\
\
    printf("Enter Reorder Level: ");\
    scanf("%d", &m[count].reorder);\
\
    count++;\
\
    printf("\\nMedicine stock added successfully!\\n");\
\}\
\
// Display Inventory\
void displayInventory()\
\{\
    int i;\
\
    printf("\\n========== MEDICINE INVENTORY ==========\\n");\
\
    for (i = 0; i < count; i++)\
    \{\
        printf("\\nMedicine ID: %d", m[i].id);\
        printf("\\nName: %s", m[i].name);\
        printf("\\nBatch: %s", m[i].batch);\
\
        printf("\\nExpiry Date: %02d/%02d/%04d",\
               m[i].day, m[i].month, m[i].year);\
\
        printf("\\nQuantity: %d", m[i].quantity);\
        printf("\\nPrice: %d", m[i].price);\
        printf("\\nReorder Level: %d\\n", m[i].reorder);\
    \}\
\}\
\
// FEFO Based Medicine Sale\
void sellMedicine()\
\{\
    char name[50];\
    int required, sold = 0;\
    int i, j, temp;\
    int order[MAX];\
\
    printf("\\nEnter Medicine Name to Sell: ");\
    scanf(" %49[^\\n]", name);\
\
    printf("Enter Required Quantity: ");\
    scanf("%d", &required);\
\
    if (required <= 0)\
    \{\
        printf("Invalid quantity!\\n");\
        return;\
    \}\
\
    // Find matching medicine batches\
    int n = 0;\
\
    for (i = 0; i < count; i++)\
    \{\
        if (strcmp(m[i].name, name) == 0 &&\
            m[i].quantity > 0)\
        \{\
            order[n++] = i;\
        \}\
    \}\
\
    // Sort batches by earliest expiry date\
    for (i = 0; i < n - 1; i++)\
    \{\
        for (j = i + 1; j < n; j++)\
        \{\
            int d1 = dateToDays(m[order[i]].day,\
                                m[order[i]].month,\
                                m[order[i]].year);\
\
            int d2 = dateToDays(m[order[j]].day,\
                                m[order[j]].month,\
                                m[order[j]].year);\
\
            if (d1 > d2)\
            \{\
                temp = order[i];\
                order[i] = order[j];\
                order[j] = temp;\
            \}\
        \}\
    \}\
\
    // Sell from earliest-expiring valid batches\
    int today = dateToDays(12, 11, 2026);\
\
    for (i = 0; i < n && sold < required; i++)\
    \{\
        int index = order[i];\
\
        int expiry = dateToDays(m[index].day,\
                                m[index].month,\
                                m[index].year);\
\
        if (expiry <= today)\
        \{\
            continue;\
        \}\
\
        int available = m[index].quantity;\
        int needed = required - sold;\
\
        int take = (available < needed) ?\
                   available : needed;\
\
        m[index].quantity -= take;\
        sold += take;\
\
        printf("\\nSold %d units from Batch %s",\
               take, m[index].batch);\
    \}\
\
    if (sold == required)\
    \{\
        printf("\\n\\nSale completed successfully!\\n");\
    \}\
    else\
    \{\
        printf("\\n\\nInsufficient valid stock!");\
        printf("\\nOnly %d units sold out of %d.\\n",\
               sold, required);\
    \}\
\}\
\
// Expiry Alert\
void expiryAlert()\
\{\
    int i;\
\
    int today = dateToDays(12, 11, 2026);\
\
    printf("\\n====== EXPIRY ALERTS ======\\n");\
\
    for (i = 0; i < count; i++)\
    \{\
        int expiry = dateToDays(m[i].day,\
                                m[i].month,\
                                m[i].year);\
\
        int difference = expiry - today;\
\
        if (m[i].quantity > 0 &&\
            difference > 0 && difference <= 30)\
        \{\
            printf("\\n%s | Batch: %s",\
                   m[i].name, m[i].batch);\
\
            printf("\\nExpires in approximately %d days\\n",\
                   difference);\
        \}\
    \}\
\}\
\
// Low Stock Alert\
void lowStockAlert()\
\{\
    int i, total;\
\
    printf("\\n====== LOW STOCK ALERTS ======\\n");\
\
    for (i = 0; i < count; i++)\
    \{\
        total = 0;\
\
        for (int j = 0; j < count; j++)\
        \{\
            if (strcmp(m[i].name, m[j].name) == 0)\
            \{\
                total += m[j].quantity;\
            \}\
        \}\
\
        if (total < m[i].reorder)\
        \{\
            printf("\\n%s - Available: %d",\
                   m[i].name, total);\
\
            printf(" | Reorder Level: %d\\n",\
                   m[i].reorder);\
        \}\
    \}\
\}\
\
// Main Function\
int main()\
\{\
    int choice;\
\
    do\
    \{\
        printf("\\n\\n================================");\
        printf("\\n       PHARMATRACK SYSTEM");\
        printf("\\n================================");\
\
        printf("\\n1. Add Medicine Stock");\
        printf("\\n2. Display Inventory");\
        printf("\\n3. Sell Medicine (FEFO)");\
        printf("\\n4. Expiry Alerts");\
        printf("\\n5. Low Stock Alerts");\
        printf("\\n6. Exit");\
\
        printf("\\n\\nEnter your choice: ");\
        scanf("%d", &choice);\
\
        switch (choice)\
        \{\
            case 1:\
                addMedicine();\
                break;\
\
            case 2:\
                displayInventory();\
                break;\
\
            case 3:\
                sellMedicine();\
                break;\
\
            case 4:\
                expiryAlert();\
                break;\
\
            case 5:\
                lowStockAlert();\
                break;\
\
            case 6:\
                printf("\\nThank you for using PharmaTrack!\\n");\
                break;\
\
            default:\
                printf("\\nInvalid choice! Try again.\\n");\
        \}\
\
    \} while (choice != 6);\
\
    return 0;\
\}}